  ],
  "landing": {"type":"target-state","persistent_visual":"When paused, Play is visible; when playing, Pause is visible, representing the available action."},
  "accessibility": {"reduced_motion":"direct-state-establish","meaning_preserved":true},
  "implementation": {"runtime":"svg-waapi","platform_profile":"web-svg-waapi","asset_id_prefix":"production-play-pause"},
  "verification": {"stable_part_tolerance_px":0.5,"scenarios":[
    {"name":"reverse-to-paused","start":"paused","first_target":"playing","interrupt_at":0.5,"second_target":"paused","expected":"paused"},
    {"name":"reverse-to-playing","start":"playing","first_target":"paused","interrupt_at":0.5,"second_target":"playing","expected":"playing"}
  ]}
}
