  "transitions": [
    {"from":"paused","to":"playing","duration_ms":140,"easing":"cubic-bezier(0.2, 0, 0, 1)","tracks":[{"part":"play","keyframes":[{"offset":0,"opacity":1},{"offset":1,"opacity":0}]},{"part":"pause","keyframes":[{"offset":0,"opacity":0},{"offset":1,"opacity":1}]}]},
