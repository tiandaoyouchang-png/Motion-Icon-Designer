{
  "id": "production-play-pause",
  "version": "1.0.0-rc4",
  "product": {"input_model":"boolean","representation_role":"action","source_of_truth":"media-playback-state","safety_relevant":false},
  "state": {"initial":"paused","allowed":["paused","playing"]},
  "behavior": {"reactivity":"transition","interrupt_policy":"reverse","loop_policy":"never"},
  "semantics": {"verb":"available playback action swaps between play and pause","primary_family":"state-morph","secondary_family":null,"no_internal_motion_reason":null},
  "geometry": {"stable_parts":[],"actors":["play","pause"],"pivot":"icon-center","emitter":null,"seam":null},
